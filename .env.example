# Discord bot token from the Discord Developer Portal
DISCORD_TOKEN=

# Optional: application / client ID (used when registering slash commands)
DISCORD_CLIENT_ID=

# Optional: register guild-scoped commands during development
DISCORD_DEV_GUILD_ID=

# PostgreSQL connection string
# Example: postgresql://USER:PASSWORD@HOST:5432/markety?schema=public
DATABASE_URL=

# Discord user ID of the single global Markety owner
MARKETY_OWNER_ID=

# Logging: info | debug | warn | error
LOG_LEVEL=info

# Node environment
NODE_ENV=production
